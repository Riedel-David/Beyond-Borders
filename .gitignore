# Build output
build/
app/build/

# Gradle and Kotlin caches. .gradle/ still appears despite the relocated project
# cache in gradle.properties (Android Studio recreates parts of it), so it is
# ignored rather than fought with.
.gradle/
.kotlin/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Signing material must never be committed
keystore.properties
*.jks
*.keystore

# Data pipelines: the source downloads (25 MB of Natural Earth, 600 kB of visa
# matrix) are reproducible from each build script's printed curl command. The
# generated assets under app/src/main/assets ARE committed, so a normal build
# never needs the caches.
tools/*/cache/

__pycache__/
*.pyc

# macOS
.DS_Store

# Private working files: never public (also purged from history)
/CLAUDE.md
/AGENTS.md
/docs/PLAN.md
/docs/STATUS.md
/docs/UI_IDEAS.md
/docs/PLAYSTORE.md
/docs/playstore/
/.claude/
/.idea/
