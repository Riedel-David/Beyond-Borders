# The Gradle wrapper's batch file must keep CRLF or cmd.exe mis-parses it.
*.bat text eol=crlf
gradlew text eol=lf

# Generated by tools/geo/build_geo.py. Marked so a regeneration does not show up
# as 130k lines of review noise; the assertions in the build script are the review.
app/src/main/assets/places.geojson -diff
app/src/main/assets/places.json -diff
