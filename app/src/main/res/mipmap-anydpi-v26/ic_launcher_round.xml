<?xml version="1.0" encoding="utf-8"?>
<!--
    Identical to ic_launcher.xml, and that is correct: an adaptive icon is masked by
    the launcher, so the round variant needs no separate artwork. The file exists only
    because android:roundIcon in the manifest points at it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
