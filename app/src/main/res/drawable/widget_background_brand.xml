<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Linear gradient from BrandDeep to BrandInk, top-left to bottom-right (315 degrees) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/brand_deep"
                android:endColor="@color/brand_ink"
                android:type="linear" />
        </shape>
    </item>
    <!-- Radial gradient from azure (at ~30% alpha) to transparent, positioned top-right -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="85%p"
                android:centerX="0.82"
                android:centerY="0.06"
                android:startColor="#4D1E6FE3"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
