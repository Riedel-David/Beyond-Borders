<?xml version="1.0" encoding="utf-8"?>
<!--
    A wireframe globe with three places marked in the app's own status colours.

    It shows what the app does rather than what it is called: no aeroplane, since
    flight tracking was built and then removed (PLAN.md revision 7) — the app is
    the country tracker now, and the icon should not advertise a screen it doesn't
    have.

    The three dots are azure, rose and teal — the shipped defaults for been, lived and
    want to. They will not follow a user's chosen palette: a launcher icon is baked
    into the APK, and repainting it at runtime is not worth an icon-pack mechanism.

    Geometry notes for anyone editing this:
      * Everything lives inside a circle of radius 33 around (54,54) — the adaptive
        icon's safe zone. The globe is radius 27, which leaves the background visible
        as a ring under every launcher mask, round or squircle.
      * The parallels are straight lines on purpose. Viewed square-on from the
        equator, every circle of latitude projects to a horizontal segment; only the
        meridians become ellipses. So this is the geometrically honest wireframe and
        also the simplest one.
      * The grid is clipped to the disc, and the outline stroke is drawn last so it
        covers the clip's aliased edges. VectorDrawable does not antialias a clip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The globe itself: a pale ocean disc. -->
    <path
        android:fillColor="#EDF3FA"
        android:pathData="M27,54 A27,27 0 0 1 81,54 A27,27 0 0 1 27,54 Z" />

    <group>
        <clip-path android:pathData="M27,54 A27,27 0 0 1 81,54 A27,27 0 0 1 27,54 Z" />

        <!-- Parallels. Drawn overlong and trimmed by the clip. -->
        <path
            android:fillColor="#00000000"
            android:pathData="M22,54 L86,54"
            android:strokeColor="#93A7C4"
            android:strokeWidth="2.2" />
        <path
            android:fillColor="#00000000"
            android:pathData="M22,40 L86,40"
            android:strokeColor="#93A7C4"
            android:strokeWidth="2.2" />
        <path
            android:fillColor="#00000000"
            android:pathData="M22,68 L86,68"
            android:strokeColor="#93A7C4"
            android:strokeWidth="2.2" />

        <!-- Meridians: the pole-to-pole line, plus one ellipse either side of it. -->
        <path
            android:fillColor="#00000000"
            android:pathData="M54,25 L54,83"
            android:strokeColor="#93A7C4"
            android:strokeWidth="2.2" />
        <path
            android:fillColor="#00000000"
            android:pathData="M54,27 A15,27 0 0 1 54,81 A15,27 0 0 1 54,27 Z"
            android:strokeColor="#93A7C4"
            android:strokeWidth="2.2" />
    </group>

    <!-- Three marked places: been, lived, want to. -->
    <path
        android:fillColor="#135CC9"
        android:pathData="M36.5,41 A6.5,6.5 0 0 1 49.5,41 A6.5,6.5 0 0 1 36.5,41 Z" />
    <path
        android:fillColor="#B0245C"
        android:pathData="M59.5,48 A6.5,6.5 0 0 1 72.5,48 A6.5,6.5 0 0 1 59.5,48 Z" />
    <path
        android:fillColor="#0F8A7E"
        android:pathData="M42.5,68 A6.5,6.5 0 0 1 55.5,68 A6.5,6.5 0 0 1 42.5,68 Z" />

    <!-- Last, so it hides where the clipped grid meets the edge. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M27,54 A27,27 0 0 1 81,54 A27,27 0 0 1 27,54 Z"
        android:strokeColor="#F7FAFD"
        android:strokeWidth="3" />
</vector>
