<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher background: deep azure, the app's primary, on a diagonal gradient.

    Flat colour would do, but the foreground globe is a pale disc almost the width of
    the safe zone, so the background is visible mostly as a ring around it. A gradient
    gives that ring something to be rather than leaving it a slab.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#1E6FE3"
                android:endColor="#0A2E67" />
        </aapt:attr>
    </path>
</vector>
