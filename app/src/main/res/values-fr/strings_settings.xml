    <!-- Welcome -->
    <string name="welcome_title">Beyond Borders</string>
    <string name="welcome_intro">Marque les lieux où tu es allé, où tu as vécu ou où tu veux aller, sur une carte de %1$d lieux. Des territoires comme le Groenland ou Porto Rico comptent à part, séparément du pays dont ils dépendent.</string>
    <string name="welcome_intro_bare">Marque les lieux où tu es allé, où tu as vécu ou où tu veux aller.</string>
    <string name="welcome_privacy">Rien de ce que tu marques ne nous est envoyé. Pas de compte, pas de serveur, pas de réseau. (La sauvegarde d\'Android peut quand même inclure tes données si elle est activée.)</string>
    <string name="welcome_passport_hint">Les conditions de visa s\'affichent pour un passeport à la fois. Choisis le tien ; tu pourras le changer plus tard dans les Paramètres.</string>
    <string name="welcome_get_started">Commencer</string>

    <!-- Database recovery -->
    <string name="recovery_title">Tes données de voyage ne peuvent pas être ouvertes</string>
    <string name="recovery_explanation">Cette version de Beyond Borders ne sait pas lire les données déjà présentes sur ton téléphone. En général, cela veut dire qu\'une ancienne version de l\'app a été installée par-dessus les données d\'une version plus récente.</string>
    <string name="recovery_reassurance">Rien n\'a été supprimé, et l\'app ne supprimera rien d\'elle-même. Réinstaller la version plus récente devrait ouvrir les données normalement. Si ce n\'est pas possible, enregistre d\'abord une copie des données : elle pourra être relue plus tard, et c\'est la seule copie qui existe sur ce téléphone.</string>
    <string name="recovery_save_copy">Enregistrer une copie</string>
    <string name="recovery_no_database">Il n\'y a aucun fichier de base de données à copier.</string>
    <string name="recovery_saved">Enregistré.</string>
    <string name="recovery_save_failed">Échec de l\'enregistrement : %1$s</string>
    <string name="recovery_open_failed">Impossible d\'ouvrir le fichier choisi.</string>
    <string name="recovery_wipe_failed">Impossible de supprimer les données. Rien n\'a été modifié de façon fiable ; réessaie, ou vide le stockage de l\'app dans les paramètres d\'Android.</string>
    <string name="recovery_delete_start_fresh">Supprimer les données et repartir de zéro</string>
    <string name="recovery_confirm_title">Supprimer tout ce que tu as marqué ?</string>
    <string name="recovery_confirm_saved">Tu as enregistré une copie, elle pourra donc être relue plus tard. Tous les lieux marqués disparaîtront de l\'app elle-même.</string>
    <string name="recovery_confirm_unsaved">Tu n\'as pas enregistré de copie. Tous les lieux que tu as marqués seront définitivement perdus, sans possibilité d\'annuler.</string>
    <string name="recovery_delete">Supprimer</string>
    <string name="recovery_keep">Conserver</string>

