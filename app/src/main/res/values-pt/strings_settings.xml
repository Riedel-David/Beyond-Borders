    <!-- Welcome -->
    <string name="welcome_title">Beyond Borders</string>
    <string name="welcome_intro">Marque os lugares onde você já esteve ou morou e aonde quer ir — em um mapa com todos os %1$d, e não só os %2$d da ONU.</string>
    <string name="welcome_intro_bare">Marque os lugares onde você já esteve ou morou e aonde quer ir.</string>
    <string name="welcome_privacy">Nada do que você marca é enviado para nós. Sem conta, sem servidor, sem rede — exporte um backup quando quiser. (O backup do próprio Android ainda pode incluir esses dados, se estiver ativado.)</string>
    <string name="welcome_passport_hint">Os requisitos de visto valem para um passaporte por vez. Escolha o seu — você pode mudar depois nos Configurações.</string>
    <string name="welcome_get_started">Começar</string>

    <!-- Database recovery -->
    <string name="recovery_title">Não foi possível abrir seus dados de viagem</string>
    <string name="recovery_explanation">Esta versão do Beyond Borders não sabe ler os dados que já estão no seu celular. Isso costuma acontecer quando uma versão mais antiga do app é instalada por cima dos dados de uma mais nova.</string>
    <string name="recovery_reassurance">Nada foi apagado e o app não apaga nada sozinho. Instalar a versão mais nova de novo deve abrir tudo normalmente. Se não der, salve primeiro uma cópia dos dados — ela poderá ser lida depois, e é a única cópia que existe neste celular.</string>
