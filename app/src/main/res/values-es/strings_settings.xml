    <string name="settings_delete_everything">Borrar todo</string>
    <string name="settings_delete_confirm_title">¿Borrar todo?</string>
    <string name="settings_delete_confirm_body">Se borrarán de este teléfono todos los lugares marcados, los pasaportes y los ajustes de visualización, así como la instantánea de la copia de seguridad de Android. Es posible que Google conserve una copia anterior hasta que Android haga la siguiente; puedes eliminarla ahora en los ajustes de copia de seguridad de Android.</string>
    <string name="settings_delete">Borrar</string>

    <string name="settings_about_title">Acerca de</string>
    <string name="settings_about_version">BeyondBorders %1$s</string>
    <string name="settings_about_open_source">Código abierto (GPL-3.0)</string>
    <string name="settings_about_data_title">Sobre los datos</string>
    <string name="settings_about_disclaimer">Una app independiente, sin vínculo con ningún gobierno ni en representación de ninguno. Los datos de visado son una instantánea y pueden estar desactualizados: confirma los requisitos de entrada en la fuente oficial del gobierno antes de viajar.</string>
    <string name="settings_about_map_title">Datos del mapa</string>
    <string name="settings_about_map">Fronteras de Natural Earth (dominio público), dibujadas con MapLibre. Todo el mapa está dentro de la app, así que funciona sin red y sin cuenta.</string>
    <string name="settings_about_backup_title">Copias de seguridad</string>
    <string name="settings_about_backup">La copia de seguridad automática de Android envía una instantánea de tu historial a tu cuenta de Google: la crea el sistema, la app nunca sube nada por sí misma. Tras reinstalar la app o en un teléfono nuevo, la app empieza vacía: no se restaura nada hasta que pulses «Restaurar». La base de datos, los ajustes y un identificador propio de cada instalación quedan totalmente fuera de la copia. Puedes desactivarla en los ajustes de copia de seguridad de Android.</string>
    <string name="settings_licences_button">Licencias de código abierto</string>

