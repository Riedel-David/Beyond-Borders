    <!-- Welcome -->
    <string name="welcome_title">Beyond Borders</string>
    <string name="welcome_intro">Marca los lugares en los que has estado o has vivido y a los que quieres ir, en un mapa con los %1$d lugares, no solo los %2$d países de la ONU.</string>
    <string name="welcome_intro_bare">Marca los lugares en los que has estado o has vivido y a los que quieres ir.</string>
    <string name="welcome_privacy">Nada de lo que marques se nos envía jamás. Sin cuenta, sin servidor, sin red; puedes exportar una copia de seguridad cuando quieras. (La copia de seguridad de Android puede incluir los datos igualmente si está activada.)</string>
    <string name="welcome_passport_hint">Las normas de visado dependen del pasaporte. Elige el tuyo; podrás cambiarlo después en Ajustes.</string>
    <string name="welcome_get_started">Empezar</string>

    <!-- Database recovery -->
    <string name="recovery_title">No se pueden abrir los datos de viaje</string>
    <string name="recovery_explanation">Esta versión de Beyond Borders no puede leer los datos que ya hay en el teléfono. Lo habitual es que se haya instalado una versión antigua de la app sobre los datos de una más reciente.</string>
    <string name="recovery_reassurance">No se ha borrado nada, y la app nunca borra nada por su cuenta. Volver a instalar la versión más reciente debería abrir los datos con normalidad. Si no es posible, guarda primero una copia de los datos: se podrá importar más tarde y es la única copia que hay en este teléfono.</string>
    <string name="recovery_save_copy">Guardar copia</string>
    <string name="recovery_no_database">No hay ningún archivo de base de datos que copiar.</string>
    <string name="recovery_saved">Guardado.</string>
    <string name="recovery_save_failed">Error al guardar: %1$s</string>
    <string name="recovery_open_failed">No se pudo abrir el archivo elegido.</string>
    <string name="recovery_wipe_failed">No se pudieron borrar los datos y no se puede garantizar su estado; inténtalo de nuevo o borra el almacenamiento de la app en los ajustes de Android.</string>
    <string name="recovery_delete_start_fresh">Borrar los datos y empezar de cero</string>
    <string name="recovery_confirm_title">¿Borrar todo lo que has marcado?</string>
    <string name="recovery_confirm_saved">Se guardó una copia que podrás importar más tarde. Todos los lugares marcados desaparecerán de la propia app.</string>
    <string name="recovery_confirm_unsaved">No se guardó ninguna copia. Todos los lugares marcados se perderán definitivamente, sin opción de deshacer.</string>
    <string name="recovery_delete">Borrar</string>
    <string name="recovery_keep">Conservar</string>

