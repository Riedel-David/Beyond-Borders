<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup and device-to-device transfer on API 31+; backup_rules.xml is the same
   decision for 26-30. See there for why the database, the settings prefs and
   widget_prefs.xml are now excluded — a reinstall must come up genuinely empty — and
   for the JSON snapshot that carries the history in their place without restoring
   itself. beyondborders.device.xml's exclusion is unrelated: see there for why.

   device-transfer gets the same exclusions. A direct transfer usually retires the
   old phone, so the id clash beyondborders.device.xml avoids is briefer, but
   "usually" is not an invariant and a fresh id costs nothing; the database and
   prefs stay out here for exactly the same reason they stay out of cloud-backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="beyondborders.db"/>
        <exclude domain="database" path="beyondborders.db-wal"/>
        <exclude domain="database" path="beyondborders.db-shm"/>
        <exclude domain="sharedpref" path="beyondborders.settings.xml"/>
        <exclude domain="sharedpref" path="widget_prefs.xml"/>
        <exclude domain="sharedpref" path="beyondborders.device.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="beyondborders.db"/>
        <exclude domain="database" path="beyondborders.db-wal"/>
        <exclude domain="database" path="beyondborders.db-shm"/>
        <exclude domain="sharedpref" path="beyondborders.settings.xml"/>
        <exclude domain="sharedpref" path="widget_prefs.xml"/>
        <exclude domain="sharedpref" path="beyondborders.device.xml"/>
    </device-transfer>
</data-extraction-rules>
