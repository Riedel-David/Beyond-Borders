<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The only colour the resource system needs. Everything else lives in
         ui/theme/Color.kt, because every screen is Compose. This one is the
         window background that shows for the frame or two before the first
         composition, so it has to match BeyondBordersLight.background exactly or
         the app flashes on launch. values-night/colors.xml has the dark twin. -->
    <color name="window_background">#F7F9FC</color>

    <!-- The widget can't read the Compose theme, so its surface/text/accent are
         copied by hand from BeyondBordersLight in ui/theme/Color.kt. values-night
         has the dark twin. -->
    <color name="widget_surface">#F7F9FC</color>
    <color name="widget_on_surface">#131A22</color>
    <color name="widget_accent">#135CC9</color>
    <!-- The quiet card's own tones. The brand card is dark in both light and dark mode,
         so its white-alpha wordmark, tile fill and tile label cannot be reused here:
         on a light quiet card they are white on near-white and vanish. -->
    <color name="widget_quiet_muted">#8A131A22</color>
    <color name="widget_quiet_tile_fill">#0D131A22</color>
    <color name="widget_quiet_tile_stroke">#1F131A22</color>

    <!-- Brand colours for the widget's filled background, copied from MapShare.kt. -->
    <color name="brand_azure">#1E6FE3</color>
    <color name="brand_deep">#0A2E67</color>
    <color name="brand_teal">#0F8A7E</color>
    <color name="brand_ink">#070B14</color>
</resources>
