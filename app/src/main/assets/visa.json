ps://www.auswaertiges-amt.de/de/service/laender","days":90,"officialUrl":"https://www.auswaertiges-amt.de/de/-/210258","officialFor":"CY"},{"code":"XS","category":"VISA_ON_ARRIVAL","source":"curated","confidence":"medium","note":"Somaliland issues its own visas and does not recognise Somali ones. A visa on arrival at Hargeisa is the usual route, or one of the liaison offices in advance. Somali visas are not valid here and vice versa.","sourceUrl":"https://www.auswaertiges-amt.de/de/service/laender","days":30,"officialUrl":"https://www.auswaertiges-amt.de/de/-/203132","officialFor":"SO"},{"code":"YE","category":"VISA_REQUIRED","source":"dataset","officialUrl":"https://www.auswaertiges-amt.de/de/-/202260"},{"code":"YT","category":"VISA_FREE","source":"curated","confidence":"high","note":"EU outermost region. Freedom of movement, no visa — outside Schengen, so there is a border check on arrival.","sourceUrl":"https://ec.europa.eu/regional_policy/policy/themes/outermost-regions_en","officialUrl":"https://www.auswaertiges-amt.de/de/-/209524","officialFor":"FR"},{"code":"ZA","category":"VISA_FREE","source":"dataset","days":90,"officialUrl":"https://www.auswaertiges-amt.de/de/-/208400"},{"code":"ZM","category":"VISA_FREE","source":"dataset","days":90,"officialUrl":"https://www.auswaertiges-amt.de/de/-/208606"},{"code":"ZW","category":"VISA_ON_ARRIVAL","source":"dataset","officialUrl":"https://www.auswaertiges-amt.de/de/-/208948"}]}